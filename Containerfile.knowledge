# Containerfile.knowledge — semantic-search image for the blogmarks EC2 deploy.
#
# Same app as Containerfile, but installs the `semantic` extra (hnswlib + numpy)
# so knowledge_index.py can build the in-process ANN index. Runs in DynamoDB
# mode against the blogmarks tables (see scripts/ec2-knowledge-userdata.sh.tftpl).
#
# Build:  podman build -f Containerfile.knowledge -t mcp-bookmarks-knowledge .
FROM python:3.12-slim AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends g++ gcc python3-dev \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src/ ./src/
# hnswlib has no wheel for this platform and compiles from C++, so build the
# artifacts here (with g++) into an isolated prefix and copy them into a clean
# runtime image below.
RUN pip install --no-cache-dir --prefix=/install ".[semantic]"

FROM python:3.12-slim AS app

COPY --from=builder /install /usr/local

ENV MCP_PORT=8000 \
    MCP_HOST=0.0.0.0 \
    KNOWLEDGE_INDEX_PATH=/data/knowledge/index.bin \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import httpx,sys; r=httpx.get('http://localhost:8000/health', timeout=3); sys.exit(0 if r.status_code==200 else 1)" || exit 1

RUN useradd --create-home --shell /bin/bash appuser && \
    mkdir -p /data/knowledge && chown -R appuser:appuser /data
USER appuser

ENTRYPOINT ["python", "-m", "mcp_bookmarks"]
