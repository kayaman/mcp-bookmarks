# MCP Bookmarks Server Configuration
MCP_PORT=8000
MCP_HOST=0.0.0.0
BOOKMARKS_DB_PATH=~/.mcp-bookmarks/bookmarks.db

# Optional: comma-separated API keys for REST (/api/*). Per-key org: secret:org-a
# MCP_API_KEYS=devkey1,devkey2:tenant-2

# Tenant for DynamoDB bookmarks + usage (MCP has no per-request key; uses this env)
# DYNAMODB_ORG_ID=my-org

# Monthly MCP/REST event cap (0 = disabled). Counted in SQLite or DYNAMODB_USAGE_TABLE.
# MCP_MONTHLY_USAGE_LIMIT=5000

# DynamoDB (production / blogmarks)
# DYNAMODB_MODE=true
# DYNAMODB_LINKS_TABLE=...
# DYNAMODB_TAGS_TABLE=...
# DYNAMODB_USAGE_TABLE=...
# DYNAMODB_SUBSCRIPTIONS_TABLE=...

# Stripe Billing → POST /webhooks/stripe (Dashboard signing secret)
# STRIPE_WEBHOOK_SECRET=whsec_...

# OpenAI embeddings (SQLite semantic search tools)
# OPENAI_API_KEY=sk-...
# OPENAI_EMBED_MODEL=text-embedding-3-small

# Optional: blogmarks-crew ingest
# BOOKMARKS_API_BASE=http://127.0.0.1:8000
