# MCP Bookmarks Server Configuration
MCP_PORT=8000
MCP_HOST=0.0.0.0
BOOKMARKS_DB_PATH=~/.mcp-bookmarks/bookmarks.db

# Optional: comma-separated API keys for REST (/api/*). Per-key org: secret:org-a
# MCP_API_KEYS=devkey1,devkey2:tenant-2

# Tenant for DynamoDB bookmarks + usage (MCP has no per-request key; uses this env)
# DYNAMODB_ORG_ID=my-org

# Monthly MCP/REST event cap (0 = disabled). Counted in SQLite or DYNAMODB_USAGE_TABLE.
# MCP_MONTHLY_USAGE_LIMIT=5000

# DynamoDB (production)
# DYNAMODB_MODE=true
# DYNAMODB_LINKS_TABLE=...
# DYNAMODB_TAGS_TABLE=...
# DYNAMODB_USAGE_TABLE=...
# DYNAMODB_SUBSCRIPTIONS_TABLE=...

# Stripe Billing → POST /webhooks/stripe (Dashboard signing secret)
# STRIPE_WEBHOOK_SECRET=whsec_...

# OpenAI embeddings (SQLite semantic search tools)
# OPENAI_API_KEY=sk-...
# OPENAI_EMBED_MODEL=text-embedding-3-small

# Optional: multi-model + LLM judge (MCP tool ensemble_with_judge, POST /api/ensemble)
# ENSEMBLE_ENABLED=true
# AI_GATEWAY_BASE_URL=https://api.openai.com/v1
# AI_GATEWAY_API_KEY=sk-...
# ENSEMBLE_MODELS=gpt-4o-mini,gpt-4o
# JUDGE_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────────────
# Blogmarks EC2 deployment: serve semantic search over Knowledge bookmarks
# against the shared blogmarks DynamoDB tables (account 257394450889).
# ─────────────────────────────────────────────────────────────────────
# DYNAMODB_MODE=true
# DYNAMODB_LINKS_TABLE=blogmarks-links
# DYNAMODB_TAGS_TABLE=blogmarks-tags
# DYNAMODB_TYPE_INDEX=userId-type-savedAt-index   # GSI (userId, bookmarkType)
# AWS_DEFAULT_REGION=us-east-1

# Reuse the shared bearer-token connections (bm_v1_*) minted by read-mcp.
# MCP_BEARER_AUTH=true
# MCP_CONNECTIONS_TABLE=blogmarks-mcp-connections   # validated via tokenHash-index
# COGNITO_USER_POOL_ID=us-east-1_iVTzSS4Ky          # first-party (owner) JWT path
# COGNITO_CLIENT_ID=...

# Semantic index over bookmarkType == "knowledge". Requires the `semantic`
# extra (hnswlib + numpy) and bedrock:InvokeModel on the embeddings model.
# OWNER_USER_ID=84585478-...-d951                   # whose Knowledge is indexed
# KNOWLEDGE_INDEX_USER_IDS=                          # optional comma-sep override
# BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
# BEDROCK_EMBED_DIMS=1024
# KNOWLEDGE_INDEX_PATH=/var/lib/mcp-bookmarks/index.bin   # EBS-backed
# KNOWLEDGE_INDEX_REFRESH_SECONDS=300
# KNOWLEDGE_INDEX_S3_BUCKET=                         # optional warm-start snapshot
# KNOWLEDGE_INDEX_S3_KEY=knowledge-index/index.bin
