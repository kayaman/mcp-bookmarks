# Copie para terraform.tfvars (não commite segredos).
# aws configure --profile sua-conta
# export AWS_PROFILE=sua-conta

aws_region           = "us-east-1"
project_name         = "blogmarks"
environment          = "prod"
cost_center          = "product-mvp"
owner_tag            = "founder"
monthly_budget_usd   = "300"
budget_alert_email   = "you@example.com"
budget_period_start  = "2025-03-01_00:00"

db_instance_class         = "db.t4g.micro"
db_allocated_storage_gb   = 20
ecs_desired_count         = 0
mcp_container_image       = "public.ecr.aws/docker/library/nginx:alpine"

# Prefer: export TF_VAR_anthropic_api_key="sk-ant-..."
anthropic_api_key         = "REPLACE_ME"
enable_lambda_processor   = true

# Public MCP endpoint (enable for production demo)
# enable_alb        = true
# ecs_desired_count = 1
# mcp_hostname      = "mcp.blogmarks.dev"
# route53_zone_id   = "Z0123456789ABCDEFGHIJ"  # your blogmarks.dev hosted zone
# mcp_api_keys      = "demo-key-1,demo-key-2:org-id"  # TF_VAR_mcp_api_keys recommended
# ai_gateway_url    = ""
# gateway_api_key   = ""

# ── Blogmarks PWA traffic (Cognito JWT auth) ────────────────────────
# Enables BearerAuthMiddleware on /mcp /sse /messages. Required for PWA users.
# mcp_bearer_auth        = true
# cognito_user_pool_id   = "us-east-1_xxxxxxxxx"
# cognito_client_id      = "xxxxxxxxxxxxxxxxxxxx"
# cognito_region         = "us-east-1"
# mcp_connections_table  = "blogmarks-mcp-connections"  # owned by the blogmarks CDK

# ── Share the blogmarks app's bookmark store ────────────────────────
# When set, mcp-bookmarks reads/writes the existing production tables
# instead of the empty terraform-managed blogmarks-prod-* tables.
# links_table_override = "blogmarks-links"
# tags_table_override  = "blogmarks-tags"
