# First-time deploy? Follow docs/go-live.md (one-page walkthrough).
#
# Copy to terraform.tfvars (do not commit secrets).
# Secrets stay in TF_VAR_* env vars; only non-sensitive config lives here.
# Required keys with no default: budget_alert_email; also
# mcp_hostname + route53_zone_id when enable_alb = true.
#
# aws configure --profile your-account
# export AWS_PROFILE=your-account

aws_region           = "us-east-1"
project_name         = "mcp-bookmarks"
environment          = "prod"
cost_center          = "product-mvp"
owner_tag            = "founder"
monthly_budget_usd   = "300"
budget_alert_email   = "you@example.com"
budget_period_start  = "2025-03-01_00:00"

db_instance_class         = "db.t4g.micro"
db_allocated_storage_gb   = 20
ecs_desired_count         = 0
mcp_container_image       = "public.ecr.aws/docker/library/nginx:alpine"

# Prefer: export TF_VAR_anthropic_api_key="sk-ant-..."
anthropic_api_key         = "REPLACE_ME"
enable_lambda_processor   = true

# Public MCP endpoint (enable for production)
# enable_alb        = true
# ecs_desired_count = 0  # keep at 0; bring up via .github/workflows/mcp-toggle.yml
# mcp_hostname      = "mcp.example.com"
# route53_zone_id   = "Z0123456789ABCDEFGHIJ"  # your hosted zone id
# mcp_api_keys      = "demo-key-1,demo-key-2:org-id"  # TF_VAR_mcp_api_keys recommended
# ai_gateway_url    = ""
# gateway_api_key   = ""

# ── Optional: Cognito JWT auth on /mcp /sse /messages ───────────────
# Enables BearerAuthMiddleware. Required when browser clients post a Cognito ID token.
# mcp_bearer_auth        = true
# cognito_user_pool_id   = "us-east-1_xxxxxxxxx"
# cognito_client_id      = "xxxxxxxxxxxxxxxxxxxx"
# cognito_region         = "us-east-1"
# mcp_connections_table  = "mcp-bookmarks-connections"  # external bm_v1_* token issuer's table

# ── Share an existing bookmark store ────────────────────────────────
# When set, mcp-bookmarks reads/writes existing tables instead of the
# terraform-managed ones. Useful when an external app owns the data.
# links_table_override = "existing-links-table"
# tags_table_override  = "existing-tags-table"
